#!/usr/bin/env bash
# Generated by jetson-cross. Adds the SDK-local CUDA include directory to
# every nvcc invocation so sysroot headers stay reachable even when
# CMake calls nvcc directly (CMakeDetermineCompilerId, for example)
# without toolchain flags.
set -eu
self=$(readlink -f "$0")
sdk=$(dirname "$(dirname "$self")")
include_dir=$(readlink -f "$sdk/cuda-host-include")
# JETSON_SDK is set by activate.sh. It must be exported for this wrapper
# to locate the sysroot CUDA target lib directory below. Defensive
# default makes the wrapper fail loudly instead of falling through to
# the host root when sourced outside an activated shell.
: "${JETSON_SDK:=$sdk}"
: "${JETSON_ROOTFS:=$JETSON_SDK/Linux_for_Tegra/rootfs}"
# Find the real nvcc. Honor JETSON_NVCC the same way activate.sh does,
# but otherwise prefer the host's nvcc: it links against the host's
# libpthread and libc, which is what is available when CMake's CUDA
# compiler-detection step runs the resulting aarch64 binary via qemu.
# The sysroot's nvcc is an ARM64 ELF that cannot load its own sysroot's
# libraries on an x86_64 host.
real_nvcc=${JETSON_NVCC:-}
if [[ -z $real_nvcc ]]; then
  for c in \
      /usr/local/cuda/bin/nvcc \
      /usr/local/cuda-@CUDA_VERSION@/bin/nvcc \
      /usr/bin/nvcc \
      "$JETSON_ROOTFS/usr/local/cuda-@CUDA_VERSION@/bin/nvcc" \
      "$JETSON_ROOTFS/usr/local/cuda/bin/nvcc"; do
    [[ -x $c ]] && { real_nvcc=$c; break; }
  done
fi
[[ -x $real_nvcc ]] || { echo "jetson-nvcc-wrapper: no nvcc found" >&2; exit 1; }
# nvcc links aarch64 binaries with -lcudart_static -lcudadevrt and looks for
# them under the host CUDA's targets/aarch64-linux/lib. That directory only
# carries stubs on a host without the matching cross-aarch64 CUDA package,
# so prepend the sysroot CUDA target lib dir (real libraries) to every -L.
sysroot_cuda_lib="$JETSON_ROOTFS/usr/local/cuda-@CUDA_VERSION@/targets/aarch64-linux/lib"
[[ -d $sysroot_cuda_lib ]] || sysroot_cuda_lib="$JETSON_ROOTFS/usr/local/cuda/targets/aarch64-linux/lib"
rebuilt=()
for arg in "$@"; do
  case $arg in
    -L*/targets/aarch64-linux/lib*) rebuilt+=("-L$sysroot_cuda_lib") ;;
    *) rebuilt+=("$arg") ;;
  esac
done
exec "$real_nvcc" -I"$include_dir" "${rebuilt[@]}"